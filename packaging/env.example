# Paperless MCP environment configuration
#
# Installed to /etc/paperless-mcp/env.example.
# Copy to /etc/paperless-mcp/env and edit for your deployment; the systemd
# unit (/usr/lib/systemd/system/paperless-mcp.service) sources
# /etc/paperless-mcp/env via EnvironmentFile=.

# --- Logging ---
# Log level for every logger in the process, FastMCP's included (DEBUG / INFO / WARNING / ERROR / CRITICAL). The -v CLI flag overrides to DEBUG. The unprefixed FASTMCP_LOG_LEVEL still works for one major version and logs a deprecation warning.
# PAPERLESS_MCP_LOG_LEVEL=INFO
# Log rendering. rich is one colour event key=value line per record, for a terminal; json is one JSON object per record, for a collector. Unset picks rich when stderr is a terminal and json everywhere else, so a container or journald gets JSON with no configuration.
# PAPERLESS_MCP_LOG_FORMAT=

# --- Domain ---
# All domain env vars use the PAPERLESS_MCP_ prefix.
# See the README and `paperless-mcp serve --help` for the full list.
#
# Example:
# PAPERLESS_MCP_EXAMPLE_VAR=value
# Base URL of the Paperless-NGX REST API, without a trailing slash. The server refuses to start without it.
# PAPERLESS_MCP_PAPERLESS_URL=
# Paperless service-account token used for outbound API requests. The server refuses to start without it.
# PAPERLESS_MCP_API_TOKEN=
# Per-request HTTP timeout in seconds.
# PAPERLESS_MCP_HTTP_TIMEOUT_SECONDS=30.0
# Retries for idempotent requests after network errors or 5xx responses.
# PAPERLESS_MCP_HTTP_RETRIES=2
# Default page size for list tools, from 1 through 100.
# PAPERLESS_MCP_DEFAULT_PAGE_SIZE=25
# Public Paperless UI URL for user-visible links; defaults to PAPERLESS_URL.
# PAPERLESS_MCP_PAPERLESS_PUBLIC_URL=
# Link lifetime in seconds when the caller requests no explicit TTL.
# PAPERLESS_MCP_TRANSFER_TTL_DEFAULT_S=3600.0
# Ceiling in seconds a caller-requested link TTL is clamped to.
# PAPERLESS_MCP_TRANSFER_TTL_MAX_S=86400.0
# Post-success grace window in seconds: a served token's TTL shrinks to this so a stalled transfer can retry within it.
# PAPERLESS_MCP_TRANSFER_GRACE_TTL_S=60.0
# Crashed-handler reclaim window in seconds for an in-flight reservation.
# PAPERLESS_MCP_TRANSFER_LEASE_S=60.0
# Maximum size in bytes of a single upload.
# PAPERLESS_MCP_TRANSFER_MAX_UPLOAD_BYTES=104857600
