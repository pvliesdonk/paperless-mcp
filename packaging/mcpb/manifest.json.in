{
  "manifest_version": "0.4",
  "name": "paperless-mcp",
  "display_name": "Paperless MCP",
  "version": "${VERSION}",
  "description": "Paperless-NGX document management over MCP: search, tag, upload, and read documents; manage tags, correspondents, document types, and custom fields.",
  "long_description": "Paperless-NGX document management over MCP: search, tag, upload, and read documents; manage tags, correspondents, document types, and custom fields.",
  "author": {
    "name": "pvliesdonk",
    "url": "https://github.com/pvliesdonk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pvliesdonk/paperless-mcp.git"
  },
  "homepage": "https://pvliesdonk.github.io/paperless-mcp/",
  "documentation": "https://pvliesdonk.github.io/paperless-mcp/",
  "support": "https://github.com/pvliesdonk/paperless-mcp/issues",
  "license": "UNLICENSED",
  "keywords": [],
  "server": {
    "type": "uv",
    "entry_point": "src/server.py",
    "mcp_config": {
      "command": "uvx",
      "args": [
        "--from",
        "pvliesdonk-paperless-mcp[all]==${VERSION}",
        "paperless-mcp",
        "serve"
      ],
      "env": {
        "PAPERLESS_MCP_SERVER_NAME": "${user_config.server_name}",
        "FASTMCP_LOG_LEVEL": "${user_config.log_level}",
        "PAPERLESS_MCP_PAPERLESS_URL": "${user_config.paperless_url}",
        "PAPERLESS_MCP_API_TOKEN": "${user_config.api_token}",
        "PAPERLESS_MCP_HTTP_TIMEOUT_SECONDS": "${user_config.http_timeout_seconds}",
        "PAPERLESS_MCP_HTTP_RETRIES": "${user_config.http_retries}",
        "PAPERLESS_MCP_DEFAULT_PAGE_SIZE": "${user_config.default_page_size}",
        "PAPERLESS_MCP_PAPERLESS_PUBLIC_URL": "${user_config.paperless_public_url}"
      }
    }
  },
  "user_config": {
    "server_name": {
      "type": "string",
      "title": "Server name",
      "description": "Rename this server instance; defaults to the project name.",
      "required": false
    },
    "log_level": {
      "type": "string",
      "title": "Log level",
      "description": "Log level for FastMCP internals and app loggers (DEBUG / INFO / WARNING / ERROR / CRITICAL). The -v CLI flag overrides to DEBUG.",
      "required": false,
      "default": "INFO"
    },
    "paperless_url": {
      "type": "string",
      "title": "Paperless API URL",
      "description": "Base URL of the Paperless-NGX REST API, without a trailing slash.",
      "required": true
    },
    "api_token": {
      "type": "string",
      "title": "Paperless API token",
      "description": "Paperless service-account token used for outbound API requests.",
      "required": true,
      "sensitive": true
    },
    "http_timeout_seconds": {
      "type": "number",
      "title": "Http Timeout Seconds",
      "description": "Per-request HTTP timeout in seconds.",
      "required": false,
      "default": 30.0
    },
    "http_retries": {
      "type": "number",
      "title": "Http Retries",
      "description": "Retries for idempotent requests after network errors or 5xx responses.",
      "required": false,
      "default": 2
    },
    "default_page_size": {
      "type": "number",
      "title": "Default Page Size",
      "description": "Default page size for list tools, from 1 through 100.",
      "required": false,
      "default": 25
    },
    "paperless_public_url": {
      "type": "string",
      "title": "Paperless Public Url",
      "description": "Public Paperless UI URL for user-visible links; defaults to PAPERLESS_URL.",
      "required": false
    }
  },
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "python": ">=3.11,<4.0"
    }
  }
}
