{
  "version": 1,
  "meta": {
    "projectName": "paperless-mcp",
    "dockerImage": "ghcr.io/pvliesdonk/paperless-mcp:latest",
    "envPrefix": "PAPERLESS_MCP"
  },
  "secretKeys": [
    "PAPERLESS_MCP_API_TOKEN",
    "PAPERLESS_MCP_BEARER_TOKEN",
    "PAPERLESS_MCP_OIDC_CLIENT_SECRET",
    "PAPERLESS_MCP_OIDC_JWT_SIGNING_KEY"
  ],
  "questions": [
    {
      "id": "paperless_url",
      "label": "Paperless API URL",
      "help": "Base URL of the Paperless-NGX instance, e.g. http://paperless:8000.",
      "type": "text",
      "var": "PAPERLESS_MCP_PAPERLESS_URL"
    },
    {
      "id": "api_token",
      "label": "Paperless API token",
      "help": "Service-account token for the Paperless-NGX API. Never included in the shareable link.",
      "type": "text",
      "var": "PAPERLESS_MCP_API_TOKEN"
    },
    {
      "id": "paperless_public_url",
      "label": "Paperless public URL",
      "help": "Public-facing Paperless UI URL when it differs from the API URL.",
      "type": "text",
      "var": "PAPERLESS_MCP_PAPERLESS_PUBLIC_URL",
      "advancedGroup": "Paperless"
    },
    {
      "id": "http_timeout_seconds",
      "label": "Paperless request timeout (seconds)",
      "type": "number",
      "var": "PAPERLESS_MCP_HTTP_TIMEOUT_SECONDS",
      "advancedGroup": "Paperless"
    },
    {
      "id": "http_retries",
      "label": "Paperless request retries",
      "type": "number",
      "var": "PAPERLESS_MCP_HTTP_RETRIES",
      "advancedGroup": "Paperless"
    },
    {
      "id": "default_page_size",
      "label": "Default Paperless page size",
      "type": "number",
      "var": "PAPERLESS_MCP_DEFAULT_PAGE_SIZE",
      "advancedGroup": "Paperless"
    },
    {
      "id": "deployment",
      "label": "Where will the server run?",
      "help": "Local stdio for Claude Desktop/Code, or an HTTP server for Docker/systemd.",
      "type": "select",
      "options": [
        { "value": "local", "label": "Local (Claude Desktop / Claude Code, stdio)", "emit": { "PAPERLESS_MCP_TRANSPORT": "stdio" } },
        { "value": "server", "label": "Server (HTTP — Docker / Compose / systemd)", "emit": { "PAPERLESS_MCP_TRANSPORT": "http" } }
      ]
    },
    {
      "id": "base_url",
      "label": "Public base URL",
      "help": "e.g. https://mcp.example.com — required for OIDC and MCP Apps.",
      "type": "text",
      "var": "PAPERLESS_MCP_BASE_URL",
      "showIf": { "deployment": ["server"] }
    },
    {
      "id": "http_path",
      "label": "HTTP endpoint path",
      "help": "Mount path for the MCP endpoint, e.g. /mcp. Defaults to /mcp when unset.",
      "type": "text",
      "var": "PAPERLESS_MCP_HTTP_PATH",
      "showIf": { "deployment": ["server"] },
      "advancedGroup": "Server"
    },
    {
      "id": "host",
      "label": "Bind host",
      "help": "Interface the HTTP server binds to. Default 127.0.0.1.",
      "type": "text",
      "var": "PAPERLESS_MCP_HOST",
      "showIf": { "deployment": ["server"] },
      "advancedGroup": "Server"
    },
    {
      "id": "port",
      "label": "Port",
      "help": "TCP port for the HTTP server. Default 8000.",
      "type": "text",
      "var": "PAPERLESS_MCP_PORT",
      "showIf": { "deployment": ["server"] },
      "advancedGroup": "Server"
    },
    {
      "id": "auth",
      "label": "Authentication",
      "type": "select",
      "showIf": { "deployment": ["server"] },
      "options": [
        { "value": "none", "label": "None" },
        { "value": "bearer", "label": "Bearer token" },
        { "value": "oidc", "label": "OIDC" },
        { "value": "both", "label": "Bearer + OIDC" }
      ]
    },
    {
      "id": "bearer_token",
      "label": "Bearer token",
      "help": "Any non-empty string enables bearer auth. Browser-only.",
      "type": "text",
      "var": "PAPERLESS_MCP_BEARER_TOKEN",
      "showIf": { "deployment": ["server"], "auth": ["bearer", "both"] }
    },
    {
      "id": "oidc_config_url",
      "label": "OIDC discovery URL",
      "help": "e.g. https://auth.example.com/.well-known/openid-configuration",
      "type": "text",
      "var": "PAPERLESS_MCP_OIDC_CONFIG_URL",
      "showIf": { "deployment": ["server"], "auth": ["oidc", "both"] }
    },
    {
      "id": "oidc_client_id",
      "label": "OIDC client ID",
      "type": "text",
      "var": "PAPERLESS_MCP_OIDC_CLIENT_ID",
      "showIf": { "deployment": ["server"], "auth": ["oidc", "both"] }
    },
    {
      "id": "oidc_client_secret",
      "label": "OIDC client secret",
      "help": "Browser-only; never in the shareable link.",
      "type": "text",
      "var": "PAPERLESS_MCP_OIDC_CLIENT_SECRET",
      "showIf": { "deployment": ["server"], "auth": ["oidc", "both"] }
    },
    {
      "id": "oidc_jwt_signing_key",
      "label": "OIDC JWT signing key",
      "help": "Required on Linux/Docker — the default is ephemeral and invalidates tokens on restart. Generate: openssl rand -hex 32.",
      "type": "text",
      "var": "PAPERLESS_MCP_OIDC_JWT_SIGNING_KEY",
      "showIf": { "deployment": ["server"], "auth": ["oidc", "both"] }
    },
    {
      "id": "oidc_audience",
      "label": "OIDC audience",
      "type": "text",
      "var": "PAPERLESS_MCP_OIDC_AUDIENCE",
      "showIf": { "deployment": ["server"], "auth": ["oidc", "both"] },
      "advancedGroup": "Auth"
    },
    {
      "id": "oidc_required_scopes",
      "label": "OIDC required scopes (CSV)",
      "type": "text",
      "var": "PAPERLESS_MCP_OIDC_REQUIRED_SCOPES",
      "showIf": { "deployment": ["server"], "auth": ["oidc", "both"] },
      "advancedGroup": "Auth"
    },
    {
      "id": "oidc_advertised_scopes",
      "label": "OIDC advertised scopes (CSV)",
      "help": "Scopes advertised to OAuth clients. Separate values with commas or spaces.",
      "type": "text",
      "var": "PAPERLESS_MCP_OIDC_ADVERTISED_SCOPES",
      "showIf": { "deployment": ["server"], "auth": ["oidc", "both"] },
      "advancedGroup": "Auth"
    },
    {
      "id": "oidc_verify_access_token",
      "label": "Verify access token (not id token)",
      "type": "bool",
      "var": "PAPERLESS_MCP_OIDC_VERIFY_ACCESS_TOKEN",
      "showIf": { "deployment": ["server"], "auth": ["oidc", "both"] },
      "advancedGroup": "Auth"
    },
    {
      "id": "bearer_tokens_file",
      "label": "Bearer tokens file (TOML)",
      "help": "Path to a TOML file of per-token subjects; overrides the single BEARER_TOKEN.",
      "type": "text",
      "var": "PAPERLESS_MCP_BEARER_TOKENS_FILE",
      "showIf": { "deployment": ["server"], "auth": ["bearer", "both"] },
      "advancedGroup": "Auth"
    },
    {
      "id": "bearer_default_subject",
      "label": "Bearer default subject",
      "help": "Subject assigned to the single bearer token. Default bearer-anon.",
      "type": "text",
      "var": "PAPERLESS_MCP_BEARER_DEFAULT_SUBJECT",
      "showIf": { "deployment": ["server"], "auth": ["bearer", "both"] },
      "advancedGroup": "Auth"
    },
    {
      "id": "kv_store_url",
      "label": "KV store URL (HTTP session persistence)",
      "type": "text",
      "var": "PAPERLESS_MCP_KV_STORE_URL",
      "showIf": { "deployment": ["server"] },
      "advancedGroup": "Persistence"
    },
    {
      "id": "tasks_url",
      "label": "Task store URL",
      "help": "Task storage URL for durable background tasks. Supports memory:// or redis:// URLs.",
      "type": "text",
      "var": "PAPERLESS_MCP_TASKS_URL",
      "showIf": { "deployment": ["server"] },
      "advancedGroup": "Persistence"
    },
    {
      "id": "app_domain",
      "label": "MCP Apps domain",
      "help": "Public domain that serves MCP Apps UI resources.",
      "type": "text",
      "var": "PAPERLESS_MCP_APP_DOMAIN",
      "showIf": { "deployment": ["server"] },
      "advancedGroup": "MCP Apps"
    },
    {
      "id": "tool_visibility",
      "label": "Tool visibility policy",
      "help": "Expose all tools, allow only selected tools, or deny selected tools.",
      "type": "select",
      "options": [
        { "value": "all", "label": "Expose all tools" },
        { "value": "allow", "label": "Allow only selected tools" },
        { "value": "deny", "label": "Deny selected tools" }
      ],
      "advancedGroup": "Tool access"
    },
    {
      "id": "tools_allow",
      "label": "Allowed tools (CSV)",
      "help": "Expose only these comma-separated tool names.",
      "type": "text",
      "var": "PAPERLESS_MCP_TOOLS_ALLOW",
      "showIf": { "tool_visibility": ["allow"] },
      "advancedGroup": "Tool access"
    },
    {
      "id": "tools_deny",
      "label": "Denied tools (CSV)",
      "help": "Hide these comma-separated tool names.",
      "type": "text",
      "var": "PAPERLESS_MCP_TOOLS_DENY",
      "showIf": { "tool_visibility": ["deny"] },
      "advancedGroup": "Tool access"
    },
    {
      "id": "log_level",
      "label": "Log level",
      "type": "text",
      "var": "FASTMCP_LOG_LEVEL",
      "advancedGroup": "Logging"
    },
    {
      "id": "rich_logging",
      "label": "Rich logging",
      "type": "bool",
      "var": "FASTMCP_ENABLE_RICH_LOGGING",
      "advancedGroup": "Logging"
    }
  ],
  "guards": [
    {
      "when": { "deployment": ["server"], "auth": ["oidc", "both"] },
      "level": "warning",
      "message": "OIDC needs BASE_URL set and (on Linux/Docker) OIDC_JWT_SIGNING_KEY — the default key is ephemeral and invalidates tokens on restart."
    }
  ]
}
